# Copy this file to .env and fill in your keys:   cp .env.example .env

# REQUIRED - Groq API key for the LLM (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED - Tavily API key for web search (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# OPTIONAL - override the model. Default is groq:openai/gpt-oss-120b.
# MODEL=groq:openai/gpt-oss-20b
